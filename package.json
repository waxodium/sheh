{
  "name": "@waxory/sheh",
  "version": "1.4.1",
  "description": "Shell Exposed over HTTP. Use your terminal through the browser locally",
  "main": "src/index.js",
  "bin": {
    "sheh": "src/index.js"
  },
  "exports": {
    "./getshell": "./build/Release/getshell.node"
  },
  "keywords": [
    "terminal",
    "browser",
    "websocket",
    "shell",
    "xterm",
    "local",
    "web-terminal",
    "cli",
    "tty"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/waxodium/sheh"
  },
  "bugs": {
    "url": "https://github.com/waxodium/sheh/issues"
  },
  "homepage": "https://github.com/waxodium/sheh#readme",
  "author": "waxodium",
  "license": "GPL-3.0",
  "type": "commonjs",
  "config": {
    "android_ndk_path": ""
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "node-pty-android-arm64": "npm:node-pty-android-arm64@^1.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "node-pty-android-arm64@^1.0.0": true
  }

}
